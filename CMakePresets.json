{
  "version": 3,
  "configurePresets": [
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug (with TSan)",
      "description": "Debug build using MinGW with ThreadSanitizer enabled",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JOBSYS_ENABLE_TSAN": "ON"
      },
      "cacheVariablesComment": {
        "-CMAKE_EXE_LINKER_FLAGS": "-static"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW Release",
      "description": "Optimized release build using MinGW",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JOBSYS_ENABLE_TSAN": "OFF"
      }
    }
  ]
}
